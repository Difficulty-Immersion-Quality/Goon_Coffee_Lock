<contentList>
	<!-- "Goon_CreateSorceryPoints_Unlock" -->
	<content contentuid="h1abdd169gfcf9g4452ga405gbdff079339bc" version="1">Flexible Casting</content>
	<content contentuid="h3bdb5b97g5accg4e0cg936bg61ddad43cdaa" version="1">You can use your &lt;LSTag Type="ActionResource" Tooltip="SorceryPoint"&gt;Sorcery Points&lt;/LSTag&gt; to &lt;LSTag Type="Spell" Tooltip="Shout_CreateSpellSlot"&gt;Create Spell Slots&lt;/LSTag&gt;, or sacrifice &lt;LSTag Tooltip="SpellSlot"&gt;Spell Slots&lt;/LSTag&gt; to &lt;LSTag Type="Spell" Tooltip="Shout_CreateSorceryPoints"&gt;Create Sorcery Points&lt;/LSTag&gt;. You learn other ways to use your &lt;LSTag Type="ActionResource" Tooltip="SorceryPoint"&gt;Sorcery Points&lt;/LSTag&gt; as you reach higher levels.&lt;br&gt;Created &lt;LSTag Tooltip="SpellSlot"&gt;Spell Slots&lt;/LSTag&gt; vanish at the end of a &lt;LSTag Tooltip="LongRest"&gt;Long Rest&lt;/LSTag&gt;. You can create &lt;LSTag Tooltip="SpellSlot"&gt;Spell Slots&lt;/LSTag&gt; no higher in level than 5th.</content>

	<!-- "Shout_CreateSorceryPoints" -->
	<content contentuid="h022085d3g34bbg47cbgac74g0c819451cb3c" version="1">Spend &lt;LSTag Tooltip="SpellSlot"&gt;Spell Slots&lt;/LSTag&gt; to gain &lt;LSTag Type="ActionResource" Tooltip="SorceryPoint"&gt;Sorcery Points&lt;/LSTag&gt;.</content>
	<!-- "Shout_CreateSorceryPoints_1" -->
	<content contentuid="ha6b19ba7gae13g420fgafc2g8d9f5c60a45f" version="1">Gain [1] &lt;LSTag Type="ActionResource" Tooltip="SorceryPoint"&gt;Sorcery Point&lt;/LSTag&gt;.</content>
	<!-- "Shout_CreateSorceryPoints_2" -->
	<content contentuid="h91b08d08gb65eg4cd1gb987gc225ff12c6a4" version="1">Gain [1] &lt;LSTag Type="ActionResource" Tooltip="SorceryPoint"&gt;Sorcery Points&lt;/LSTag&gt;.</content>

	<!-- "Shout_CreateSpellSlot" -->
	<content contentuid="h63d3d1e9g8fc3g4517g9f03g2c7b9b1399a8" version="1">Spend &lt;LSTag Type="ActionResource" Tooltip="SorceryPoint"&gt;Sorcery Points&lt;/LSTag&gt; to unlock a &lt;LSTag Tooltip="SpellSlot"&gt;Spell Slot&lt;/LSTag&gt;.</content>	
	<!-- "Shout_CreateSpellSlot_1" -->
	<content contentuid="hf04b5092g8112g4b7dg85e5g28203a1ea531" version="1">Gain a level [2] &lt;LSTag Tooltip="SpellSlot"&gt;Spell Slot&lt;/LSTag&gt;.</content>
